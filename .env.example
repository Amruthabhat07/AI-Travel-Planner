# ============================================================
#  AI Travel Planner – Environment Variable Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================

# ─── Required: Google Gemini ─────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key

# ─── Gemini Model (Optional) ─────────────────────────────────
# Supported models: gemini-2.5-flash, gemini-2.5-pro, etc.
# See: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# ─── Required: Tavily Web Search ─────────────────────────────
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Optional: LangSmith Tracing ─────────────────────────────
# Obtain from: https://smith.langchain.com/
# Set LANGSMITH_TRACING=true to enable agent tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel-planner

# ─── Optional: Geoapify (Future – Location & Places) ─────────
# Obtain from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ─── Application Settings ────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── FastAPI Backend ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins. Set this to your deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./travel_planner.db
